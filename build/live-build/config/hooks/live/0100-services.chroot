#!/bin/sh
# Live-build chroot-hook: basisservices en live-gebruiker klaarzetten.
set -eu

echo "LinuxBeOS: services inschakelen"
systemctl enable NetworkManager.service
systemctl enable NetworkManager-wait-online.service
systemctl enable lightdm.service
systemctl enable linuxbeos-installed-ready.service
systemctl set-default graphical.target

# De live-gebruiker moet zonder wachtwoord kunnen beheren (gebruikelijk in
# live-sessies). Dat is nodig voor de installer, de sessie-rookmarkering en
# de geautomatiseerde installatietest.
printf '%s\n' "${LIVE_USER:-live} ALL=(ALL) NOPASSWD: ALL" \
  > /etc/sudoers.d/010-live-nopasswd
chmod 0440 /etc/sudoers.d/010-live-nopasswd

# Debian-snapper ontdekt configuraties niet automatisch. Zorg dat de
# root-configuratie ook actief is als een pakket /etc/default/snapper later
# zou overschrijven.
if [ -f /etc/default/snapper ]; then
  sed -i 's/^SNAPPER_CONFIGS=.*/SNAPPER_CONFIGS="root"/' /etc/default/snapper
fi
