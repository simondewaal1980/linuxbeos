# Branding voor LinuxBeOS (fase 4): volledige BeOS 5-vormgeving.
#
# De kleuren volgen het LinuxBeOS-desktopthema: BeOS-grijs (#d6d6d6) met
# de kenmerkende gele titeltab (#f5e64b) en donkere tekst. De slideshow
# vertelt de pijlers van de distributie; er worden geen BeOS- of
# Haiku-beeldmerken gebruikt.
---
componentName: linuxbeos

welcomeStyleCalamares: true
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 960px,600px
windowPlacement: center

sidebar: widget
navigation: widget

strings:
    productName:         "LinuxBeOS"
    shortProductName:    "LinuxBeOS"
    version:             "0.1"
    shortVersion:        "0.1"
    versionedName:       "LinuxBeOS 0.1"
    shortVersionedName:  "LinuxBeOS 0.1"
    bootloaderEntryName: "LinuxBeOS"
    # Geen externe urls; de knoppen blijven daardoor verborgen.
    productUrl:          ""
    supportUrl:          ""
    knownIssuesUrl:      ""
    releaseNotesUrl:     ""
    donateUrl:           ""

images:
    productIcon:    "logo.svg"
    productLogo:    "logo.svg"
    productWelcome: "welcome.svg"

# BeOS-palet: grijze zijbalk, zwarte tekst en een gele actieve tab.
style:
    SidebarBackground:        "#d6d6d6"
    SidebarText:              "#101010"
    SidebarTextCurrent:       "#101010"
    SidebarBackgroundCurrent: "#f5e64b"

slideshow: "show.qml"
slideshowAPI: 2

uploadServer:
    type: "none"
