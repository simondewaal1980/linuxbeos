# Snapper-configuratie voor de LinuxBeOS-root-subvolume (/@).
#
# Wordt tijdens de build naar /etc/snapper/configs/root gekopieerd. Snapper
# gebruikt deze configuratie voor tijdlijn-snapshots, de apt-hook en
# handmatige snapshots. /home, /var/log, /var/cache en /.snapshots zijn
# aparte subvolumes en worden dus niet mee teruggerold.

SUBVOLUME="/"
FSTYPE="btrfs"

# Geen qgroups: de ruimte wordt via de gewone limieten beheerd.
QGROUP=""

SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"

ALLOW_USERS=""
ALLOW_GROUPS=""
SYNC_ACL="no"

BACKGROUND_COMPARISON="yes"

NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="1800"
NUMBER_LIMIT="30"
NUMBER_LIMIT_IMPORTANT="10"

TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="5"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="4"
TIMELINE_LIMIT_MONTHLY="6"
TIMELINE_LIMIT_YEARLY="0"

EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"
